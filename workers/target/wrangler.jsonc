{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "worker-version-routing-target",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-05",
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"vars": {
		"LAB_ID": "",
		"ENVIRONMENT": "production",
		"PREVIEW_KEY": "",
		"RESPONSE_VARIANT": "standard",
		"RELEASE": "production",
		"WORKER_NAME": "worker-version-routing-target",
		"CALLER_ORIGIN": "https://worker-version-routing-caller.example.workers.dev",
		"WORKERS_DEV_SUBDOMAIN": "example"
	},
	"previews": {
		"version_metadata": { "binding": "CF_VERSION_METADATA" },
		"observability": {
			"enabled": true,
			"logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1, "persist": true },
			"traces": { "enabled": true, "head_sampling_rate": 1, "persist": true }
		},
		"vars": {
			"LAB_ID": "",
			"ENVIRONMENT": "preview",
			"PREVIEW_KEY": "branch-setup",
			"RESPONSE_VARIANT": "compact",
			"RELEASE": "preview",
			"WORKER_NAME": "worker-version-routing-target",
			"CALLER_ORIGIN": "https://worker-version-routing-caller.example.workers.dev",
			"WORKERS_DEV_SUBDOMAIN": "example"
		}
	}
}
